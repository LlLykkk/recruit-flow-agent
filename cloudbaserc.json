{
  "envId": "YOUR_CLOUDBASE_ENV_ID",
  "functionRoot": "./",
  "functions": [
    {
      "name": "recruit-flow-agent",
      "type": "HTTP",
      "runtime": "Nodejs18.15",
      "memorySize": 256,
      "timeout": 30,
      "installDependency": false,
      "ignore": [
        ".git",
        "node_modules/tencentcloud-sdk-nodejs",
        "node_modules/@larksuiteoapi",
        "*.log",
        "server.log",
        ".env"
      ],
      "envVariables": {
        "FEISHU_MODE": "real",
        "NODE_ENV": "production"
      }
    }
  ]
}
