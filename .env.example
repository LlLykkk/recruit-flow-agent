# ============================================================
# 招生控流智能体 · 环境变量示例
# 复制本文件为 .env 并填写；CloudBase 部署时在控制台/CLI 配置同名变量或密钥。
# 所有项均可留空 —— 留空时自动进入 mock/回退模式，本地 demo 完整可跑。
# ============================================================

# 服务端口（CloudBase HTTP 函数由平台注入 PORT，本地默认 9000）
PORT=9000

# 飞书对接模式：mock（内存模拟，无需凭证）| real（真实飞书开放平台）
FEISHU_MODE=mock

# ---- 腾讯混元（大模型）----
# 缺失则走规则化回退，本地 demo 仍可跑。
HUNYUAN_SECRET_ID=
HUNYUAN_SECRET_KEY=
# 模型：hunyuan-lite（默认轻量）/ hunyuan-standard / hunyuan-pro
HUNYUAN_MODEL=hunyuan-lite
HUNYUAN_REGION=ap-guangzhou

# ---- 可插拔：OpenAI 兼容接口（可选）----
# 若用 DeepSeek/GPT 等，填下面三项，并在代码切换到 openai 通道。
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-chat

# ---- 飞书自建应用（仅 FEISHU_MODE=real 需要）----
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=     # 事件订阅 verification token
FEISHU_ENCRYPT_KEY=            # 事件订阅 Encrypt Key（可选）
FEISHU_BASE_APP_TOKEN=         # 《招生控流工作流》多维表 app_token
FEISHU_TABLE_ACTION=           # 行动主表 table_id
FEISHU_TABLE_TASK=             # 任务包表 table_id
FEISHU_TABLE_VOUCHER=          # 凭证表 table_id
FEISHU_TABLE_SCHOOL=           # 学校档案表 table_id
FEISHU_NOTIFY_CHAT_ID=         # 通知接收群/人 chat_id 或 open_id

# ---- 腾讯云 CloudBase 环境 ID（部署用，运行不依赖）----
CLOUDBASE_ENV_ID=

# MVP 试点校（温州慧中公学）
MVP_SCHOOL_ID=wenzhou_huizhong
